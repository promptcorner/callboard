{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "landingPage": "/",
  "login": true,
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Callboard Demo",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "callboard.zip"
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/manifest.json",
      "data": {
        "resource": "url",
        "url": "demo/manifest.json"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/levels.json",
      "data": {
        "resource": "url",
        "url": "demo/levels.json"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/cover.png",
      "data": {
        "resource": "url",
        "url": "demo/cover.png"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/01 - Intensities in Ten Cities [intensities].mp3",
      "data": {
        "resource": "url",
        "url": "demo/01%20-%20Intensities%20in%20Ten%20Cities%20%5Bintensities%5D.mp3"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/02 - Underground [underground].mp3",
      "data": {
        "resource": "url",
        "url": "demo/02%20-%20Underground%20%5Bunderground%5D.mp3"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/03 - Trombone Detritus [detritus].mp3",
      "data": {
        "resource": "url",
        "url": "demo/03%20-%20Trombone%20Detritus%20%5Bdetritus%5D.mp3"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/04 - It's a Brand New Day [new-day].mp3",
      "data": {
        "resource": "url",
        "url": "demo/04%20-%20It%27s%20a%20Brand%20New%20Day%20%5Bnew-day%5D.mp3"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/05 - Stole Back My Soul [stole-back].mp3",
      "data": {
        "resource": "url",
        "url": "demo/05%20-%20Stole%20Back%20My%20Soul%20%5Bstole-back%5D.mp3"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/06 - Sunk in Dars [sunk-in-dars].mp3",
      "data": {
        "resource": "url",
        "url": "demo/06%20-%20Sunk%20in%20Dars%20%5Bsunk-in-dars%5D.mp3"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/07 - Little Dreamer, Big Dreams [little-dreamer].mp3",
      "data": {
        "resource": "url",
        "url": "demo/07%20-%20Little%20Dreamer%2C%20Big%20Dreams%20%5Blittle-dreamer%5D.mp3"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/08 - Convergence [convergence].mp3",
      "data": {
        "resource": "url",
        "url": "demo/08%20-%20Convergence%20%5Bconvergence%5D.mp3"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/09 - Hickory and Twine [hickory].mp3",
      "data": {
        "resource": "url",
        "url": "demo/09%20-%20Hickory%20and%20Twine%20%5Bhickory%5D.mp3"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/uploads/callboard/demo-set/10 - Everyday Adventures [everyday].mp3",
      "data": {
        "resource": "url",
        "url": "demo/10%20-%20Everyday%20Adventures%20%5Beveryday%5D.mp3"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; update_option( 'callboard_settings', array( 'tagline' => 'Rehearsal tracks', 'footer_note' => 'For rehearsal use only.', 'badge' => '★', 'confetti' => '22', 'hearts' => true, 'show_hint' => false, 'offline' => true ) ); Callboard\\Importer::import_all(); flush_rewrite_rules(); ?>"
    }
  ]
}
